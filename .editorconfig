root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing whitespace is a Markdown hard line break; textclean protects fenced
# code blocks in Markdown, and this repo's own .editorconfig says the same.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
